{
  "projectsApiUrl": "/api/pixel-art/projects",
  "projectPixelsApiUrl": "/api/pixel-art/projects/{projectId}/pixels",
  "pageSize": 12,
  "routePlaceholders": {
    "projectId": "{projectId}"
  },
  "request": {
    "method": "POST",
    "updateMethod": "PUT",
    "formKeys": {
      "name": "name",
      "settings": "settings",
      "image": "image"
    },
    "contentTypeHeader": "Content-Type",
    "jsonContentType": "application/json"
  },
  "fileInputId": "pixel-art-image-file",
  "fileAccept": "image/jpeg,image/png,image/webp",
  "defaultProjectName": "像素图项目",
  "emptyFileCount": 0,
  "workflow": {
    "uploadStep": 1,
    "preprocessingStep": 2,
    "gridStep": 3,
    "editStep": 4,
    "initialStep": 1
  },
  "ratios": [
    { "label": "1:1", "width": 1, "height": 1 },
    { "label": "4:3", "width": 4, "height": 3 },
    { "label": "16:9", "width": 16, "height": 9 },
    { "label": "3:4", "width": 3, "height": 4 },
    { "label": "9:16", "width": 9, "height": 16 }
  ],
  "grid": {
    "defaultWidth": 64,
    "minimumDimension": 1,
    "maximumWidth": 128,
    "maximumHeight": 128,
    "dimensionStep": 1
  },
  "crop": {
    "minimumDimension": 1,
    "initialCoverageRatio": 0.82,
    "defaultX": 0,
    "defaultY": 0,
    "customRatioDefaultWidth": 2,
    "customRatioDefaultHeight": 1,
    "customRatioMinimum": 1,
    "customRatioMaximum": 99,
    "customRatioStep": 1,
    "handleRadius": 7,
    "handleStrokeWidth": 2,
    "overlayFill": "rgba(9, 22, 17, 0.42)",
    "frameColor": "#f9faf7",
    "handleColor": "#1f7a5a"
  },
  "color": {
    "defaultCount": 16,
    "options": [2, 4, 8, 16, 24, 32, 48, 64],
    "sampleColorIndex": -1
  },
  "algorithms": {
    "default": "photo_illustration",
    "photoIllustration": "photo_illustration",
    "logoText": "logo_text",
    "sideMixedPlateBrickPixel": "side_mixed_plate_brick_pixel",
    "options": [
      { "id": "photo_illustration", "label": "照片/插画" },
      { "id": "logo_text", "label": "Logo/文字" },
      { "id": "side_mixed_plate_brick_pixel", "label": "侧面 Plate/Brick 混合" }
    ]
  },
  "sideLayout": {
    "pixelWidthPlates": 1,
    "pixelHeightPlates": 1,
    "brickPartType": "brick",
    "platePartType": "plate",
    "brickStartRole": "start",
    "summaryLabel": "Side layout",
    "sidePixelLabel": "Plate x Plate",
    "brickLabel": "Brick",
    "plateLabel": "Plate",
    "brickStrokeColor": "rgba(37, 99, 235, 0.82)",
    "plateStrokeColor": "rgba(180, 83, 9, 0.72)",
    "overlayLineWidth": 2
  },
  "preprocessing": {
    "brightness": { "default": 1, "minimum": 0.7, "maximum": 1.3, "step": 0.05 },
    "contrast": { "default": 1.1, "minimum": 0.7, "maximum": 1.6, "step": 0.05 },
    "saturation": { "default": 1, "minimum": 0.5, "maximum": 1.5, "step": 0.05 },
    "sharpness": { "default": 1.15, "minimum": 0.7, "maximum": 1.8, "step": 0.05 },
    "localContrast": { "default": 0.35, "minimum": 0, "maximum": 1, "step": 0.05 },
    "preserveLightDetails": true
  },
  "previewProcessing": {
    "identityValue": 1,
    "redChannelIndex": 0,
    "greenChannelIndex": 1,
    "blueChannelIndex": 2,
    "channelStride": 4,
    "rgbMinimum": 0,
    "rgbMaximum": 255,
    "luminanceRedWeight": 0.299,
    "luminanceGreenWeight": 0.587,
    "luminanceBlueWeight": 0.114,
    "sharpnessCenterWeight": 4,
    "neighborCount": 4
  },
  "canvas": {
    "pixelRatioLimit": 2,
    "minimumCanvasPixels": 1,
    "cropCanvasFallbackWidth": 780,
    "cropCanvasFallbackHeight": 560,
    "editorCanvasFallbackWidth": 520,
    "editorCanvasFallbackHeight": 420,
    "backgroundColor": "#dce5df",
    "gridLineMinCellPixels": 7,
    "gridLineWidth": 1,
    "gridColor": "rgba(23, 32, 27, 0.12)",
    "selectionColor": "rgba(31, 122, 90, 0.22)",
    "selectionStrokeColor": "#1f7a5a",
    "selectionStrokeWidth": 2,
    "zoomStep": 1.12,
    "minimumZoom": 0.35,
    "maximumZoom": 12,
    "initialZoom": 1,
    "initialOffsetX": 0,
    "initialOffsetY": 0,
    "wheelZoomInDirection": 0,
    "screenCenterDivisor": 2
  },
  "pointer": {
    "leftButton": 0
  },
  "selection": {
    "keySeparator": ":"
  },
  "history": {
    "maxSteps": 10
  },
  "texts": {
    "title": "图片像素化",
