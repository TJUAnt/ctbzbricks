{
  "projectsApiUrl": "/api/pixel-art/projects",
  "projectPixelsApiUrl": "/api/pixel-art/projects/{projectId}/pixels",
  "pageSize": 12,
  "routePlaceholders": {
    "projectId": "{projectId}"
  },
  "request": {
    "method": "POST",
    "updateMethod": "PUT",
    "formKeys": {
      "name": "name",
      "contentLocale": "contentLocale",
      "settings": "settings",
      "image": "image"
    },
    "contentTypeHeader": "Content-Type",
    "jsonContentType": "application/json"
  },
  "fileInputId": "pixel-art-image-file",
  "fileAccept": "image/jpeg,image/png,image/webp",
  "defaultProjectName": "pixelArt:defaultProjectName",
  "emptyFileCount": 0,
  "workflow": {
    "uploadStep": 1,
    "preprocessingStep": 2,
    "gridStep": 3,
    "editStep": 4,
    "initialStep": 1
  },
  "ratios": [
    {
      "label": "pixelArt:ratios.0.label",
      "width": 1,
      "height": 1
    },
    {
      "label": "pixelArt:ratios.1.label",
      "width": 4,
      "height": 3
    },
    {
      "label": "pixelArt:ratios.2.label",
      "width": 16,
      "height": 9
    },
    {
      "label": "pixelArt:ratios.3.label",
      "width": 3,
      "height": 4
    },
    {
      "label": "pixelArt:ratios.4.label",
      "width": 9,
      "height": 16
    }
  ],
  "grid": {
    "defaultWidth": 64,
    "minimumDimension": 1,
    "maximumWidth": 128,
    "maximumHeight": 128,
    "dimensionStep": 1
  },
  "crop": {
    "minimumDimension": 1,
    "initialCoverageRatio": 0.82,
    "defaultX": 0,
    "defaultY": 0,
    "customRatioDefaultWidth": 2,
    "customRatioDefaultHeight": 1,
    "customRatioMinimum": 1,
    "customRatioMaximum": 99,
    "customRatioStep": 1,
    "handleRadius": 7,
    "handleStrokeWidth": 2,
    "overlayFill": "rgba(9, 22, 17, 0.42)",
    "frameColor": "#f9faf7",
    "handleColor": "#1f7a5a"
  },
  "color": {
    "defaultCount": 16,
    "options": [
      2,
      4,
      8,
      16,
      24,
      32,
      48,
      64
    ],
    "sampleColorIndex": -1
  },
  "algorithms": {
    "default": "photo_illustration",
    "photoIllustration": "photo_illustration",
    "logoText": "logo_text",
    "sideMixedPlateBrickPixel": "side_mixed_plate_brick_pixel",
    "options": [
      {
        "id": "photo_illustration",
        "label": "pixelArt:algorithms.options.photo_illustration.label"
      },
      {
        "id": "logo_text",
        "label": "pixelArt:algorithms.options.logo_text.label"
      },
      {
        "id": "side_mixed_plate_brick_pixel",
        "label": "pixelArt:algorithms.options.side_mixed_plate_brick_pixel.label"
      }
    ]
  },
  "sideLayout": {
    "pixelWidthPlates": 1,
    "pixelHeightPlates": 1,
    "brickPartType": "brick",
    "platePartType": "plate",
    "brickStartRole": "start",
    "summaryLabel": "pixelArt:sideLayout.summaryLabel",
    "sidePixelLabel": "pixelArt:sideLayout.sidePixelLabel",
    "brickLabel": "pixelArt:sideLayout.brickLabel",
    "plateLabel": "pixelArt:sideLayout.plateLabel",
    "brickStrokeColor": "rgba(37, 99, 235, 0.82)",
    "plateStrokeColor": "rgba(180, 83, 9, 0.72)",
    "overlayLineWidth": 2
  },
  "preprocessing": {
    "brightness": {
      "default": 1,
      "minimum": 0.7,
      "maximum": 1.3,
      "step": 0.05
    },
    "contrast": {
      "default": 1.1,
      "minimum": 0.7,
      "maximum": 1.6,
      "step": 0.05
    },
    "saturation": {
      "default": 1,
      "minimum": 0.5,
      "maximum": 1.5,
      "step": 0.05
    },
    "sharpness": {
      "default": 1.15,
      "minimum": 0.7,
      "maximum": 1.8,
      "step": 0.05
    },
    "localContrast": {
      "default": 0.35,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05
    },
    "preserveLightDetails": true
  },
  "previewProcessing": {
    "identityValue": 1,
    "redChannelIndex": 0,
    "greenChannelIndex": 1,
    "blueChannelIndex": 2,
    "channelStride": 4,
    "rgbMinimum": 0,
    "rgbMaximum": 255,
    "luminanceRedWeight": 0.299,
    "luminanceGreenWeight": 0.587,
    "luminanceBlueWeight": 0.114,
    "sharpnessCenterWeight": 4,
    "neighborCount": 4
  },
  "canvas": {
    "pixelRatioLimit": 2,
    "minimumCanvasPixels": 1,
    "cropCanvasFallbackWidth": 780,
    "cropCanvasFallbackHeight": 560,
    "editorCanvasFallbackWidth": 520,
    "editorCanvasFallbackHeight": 420,
    "backgroundColor": "#dce5df",
    "gridLineMinCellPixels": 7,
    "gridLineWidth": 1,
    "gridColor": "rgba(23, 32, 27, 0.12)",
    "selectionColor": "rgba(31, 122, 90, 0.22)",
    "selectionStrokeColor": "#1f7a5a",
    "selectionStrokeWidth": 2,
    "zoomStep": 1.12,
    "minimumZoom": 0.35,
    "maximumZoom": 12,
    "initialZoom": 1,
    "initialOffsetX": 0,
    "initialOffsetY": 0,
    "wheelZoomInDirection": 0,
    "screenCenterDivisor": 2
  },
  "pointer": {
    "leftButton": 0
  },
  "selection": {
    "keySeparator": ":"
  },
  "history": {
    "maxSteps": 10
  },
  "texts": {
    "title": "pixelArt:texts.title",
    "subtitle": "pixelArt:texts.subtitle",
    "stepUpload": "pixelArt:texts.stepUpload",
    "stepPreprocessing": "pixelArt:texts.stepPreprocessing",
    "stepGrid": "pixelArt:texts.stepGrid",
    "stepEdit": "pixelArt:texts.stepEdit",
    "uploadImage": "pixelArt:texts.uploadImage",
    "savedProjects": "pixelArt:texts.savedProjects",
    "savedProjectsSubtitle": "pixelArt:texts.savedProjectsSubtitle",
    "emptyProjects": "pixelArt:texts.emptyProjects",
    "loadProjectsFailed": "pixelArt:texts.loadProjectsFailed",
    "refresh": "pixelArt:texts.refresh",
    "sourceImage": "pixelArt:texts.sourceImage",
    "projectName": "pixelArt:texts.projectName",
    "projectNamePlaceholder": "pixelArt:texts.projectNamePlaceholder",
    "ratio": "pixelArt:texts.ratio",
    "customRatio": "pixelArt:texts.customRatio",
    "customRatioWidth": "pixelArt:texts.customRatioWidth",
    "customRatioHeight": "pixelArt:texts.customRatioHeight",
    "confirmCrop": "pixelArt:texts.confirmCrop",
    "backToCrop": "pixelArt:texts.backToCrop",
    "confirmPreprocessing": "pixelArt:texts.confirmPreprocessing",
    "backToPreprocessing": "pixelArt:texts.backToPreprocessing",
    "confirmGrid": "pixelArt:texts.confirmGrid",
    "backToGrid": "pixelArt:texts.backToGrid",
    "outputGrid": "pixelArt:texts.outputGrid",
    "gridWidth": "pixelArt:texts.gridWidth",
    "gridHeight": "pixelArt:texts.gridHeight",
    "totalCells": "pixelArt:texts.totalCells",
    "colorCount": "pixelArt:texts.colorCount",
    "algorithm": "pixelArt:texts.algorithm",
    "preprocessing": "pixelArt:texts.preprocessing",
    "brightness": "pixelArt:texts.brightness",
    "contrast": "pixelArt:texts.contrast",
    "saturation": "pixelArt:texts.saturation",
    "sharpness": "pixelArt:texts.sharpness",
    "localContrast": "pixelArt:texts.localContrast",
    "preserveLightDetails": "pixelArt:texts.preserveLightDetails",
    "generate": "pixelArt:texts.generate",
    "generating": "pixelArt:texts.generating",
    "saveEdits": "pixelArt:texts.saveEdits",
    "savingEdits": "pixelArt:texts.savingEdits",
    "undo": "pixelArt:texts.undo",
    "redo": "pixelArt:texts.redo",
    "saved": "pixelArt:texts.saved",
    "editsSaved": "pixelArt:texts.editsSaved",
    "saveFailed": "pixelArt:texts.saveFailed",
    "emptyImage": "pixelArt:texts.emptyImage",
    "emptyResult": "pixelArt:texts.emptyResult",
    "palette": "pixelArt:texts.palette",
    "selectedCells": "pixelArt:texts.selectedCells",
    "pixelCount": "pixelArt:texts.pixelCount",
    "modelId": "pixelArt:texts.modelId",
    "imageSize": "pixelArt:texts.imageSize",
    "pickFromSource": "pixelArt:texts.pickFromSource",
    "candidateColors": "pixelArt:texts.candidateColors",
    "clearSelection": "pixelArt:texts.clearSelection",
    "selectCells": "pixelArt:texts.selectCells",
    "panCanvas": "pixelArt:texts.panCanvas",
    "editSource": "pixelArt:texts.editSource",
    "pixelEditor": "pixelArt:texts.pixelEditor",
    "cropWorkspace": "pixelArt:texts.cropWorkspace"
  }
}
