APP_ENV=development
GO_BACKEND_HOST=127.0.0.1
GO_BACKEND_PORT=8080

# Go uses PostgreSQL directly. Do not use a SQLAlchemy driver suffix here.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MIN_CONNS=1
DATABASE_POOL_MAX_CONNS=10
DATABASE_POOL_MAX_CONN_LIFETIME=30m
DATABASE_POOL_MAX_CONN_IDLE_TIME=5m
DATABASE_POOL_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=5s

# Component Repo endpoints accept Supabase asymmetric signing keys through
# JWKS. AUTH_JWKS_URL is derived from AUTH_JWT_ISSUER when omitted. Keep the
# legacy HS256 secret only while old tokens still need to be accepted.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
AUTH_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_AUDIENCE=authenticated
# Full-page refreshes call the Go session endpoint once. Provider outages return
# a retryable error and must not clear the browser session.
AUTH_SESSION_VERIFICATION_TIMEOUT=5s

# G4 object storage. Leave disabled for API-only local work.
STORAGE_PROVIDER=disabled
STORAGE_BUCKET=component-artifacts
STORAGE_KEY_PREFIX=component-repo
SUPABASE_URL=
# Shared public project key used by Go session verification and Storage apikey.
# User-facing requests use the already-verified request JWT as Bearer authorization.
SUPABASE_PUBLISHABLE_KEY=
# Optional for API-only reads, required by Workers and server-side cleanup.
# Use SUPABASE_SECRET_KEY for a modern sb_secret_* key, or the legacy
# SUPABASE_STORAGE_SERVICE_ROLE_KEY. Never expose either to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
STORAGE_REQUEST_TIMEOUT=30s
STORAGE_SIGNED_URL_TTL=15m
STORAGE_UPLOAD_SESSION_TTL=1h
STORAGE_MAX_ARTIFACT_BYTES=536870912
COMPONENT_IMPORT_PARSER_VERSION=component-repo-ldraw-parser-v2
COMPONENT_IMPORT_SNAPSHOT_SCHEMA=component-repo-v2
COMPONENT_IMPORT_MAX_ATTEMPTS=3
# Optional on API-only processes. Go Workers with this read-only LDraw library
# mount register the component.part_preview.materialize capability.
LDRAW_ROOT=
# Part GLB v2 使用固定的 gltfpack 1.2 写入 EXT_meshopt_compression；原生优先，可填写绝对路径。
PART_PREVIEW_GLTFPACK_PATH=gltfpack
# Python component parser Worker uses numeric seconds for its independent process.
PYTHON_COMPONENT_WORKER_ID=component-parser-1
PYTHON_RELATION_WORKER_ID=component-relations-1
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_LEASE_DURATION_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_RETRY_DELAY_SECONDS=5

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=2m
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=2097152

WORKER_ID=component-worker-1
# 逗号分隔；留空注册全部能力。维护/回填进程可限制为单一 durable task type。
WORKER_TASK_TYPES=
WORKER_HEALTH_CHECK_INTERVAL=30s
WORKER_POLL_INTERVAL=500ms
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_RETRY_DELAY=5s
WORKER_CONCURRENCY=4
