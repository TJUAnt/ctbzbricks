# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.0
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src/backend-go

COPY backend-go/go.mod backend-go/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend-go/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS blender
ARG TARGETARCH
ARG BLENDER_VERSION=4.1.0
ARG BLENDER_SHA256=d2ac5390f4a9cb9416c8eb23bdd8fa8e49e68165a889575fd8f56563f5cccaf1
RUN test "${TARGETARCH}" = "amd64" && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    curl --fail --location --retry 3 --retry-all-errors \
      --output /tmp/blender.tar.xz \
      "https://download.blender.org/release/Blender4.1/blender-${BLENDER_VERSION}-linux-x64.tar.xz" && \
    echo "${BLENDER_SHA256}  /tmp/blender.tar.xz" | sha256sum --check - && \
    mkdir -p /opt/blender && \
    tar --extract --xz --file /tmp/blender.tar.xz --strip-components=1 --directory /opt/blender

FROM debian:bookworm-slim AS runtime
# Blender 后台模式仍会动态加载基础图形和字体库；渲染任务本身固定使用 CPU Cycles。
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates libdbus-1-3 libegl1 libfontconfig1 libgl1 libglib2.0-0 libice6 libsm6 \
      libx11-6 libx11-xcb1 libxcb1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrender1 \
      libxxf86vm1 procps tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 brickbuilder && \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin brickbuilder

WORKDIR /app
COPY --from=build --chown=10001:10001 /out/worker /app/worker
COPY --from=blender --chown=10001:10001 /opt/blender /opt/blender

USER 10001:10001
ENTRYPOINT ["/app/worker"]
