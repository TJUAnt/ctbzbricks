{
  "description": "Persistent model fitting jobs, target analysis, blocks, and editable solutions.",
  "routes": {
    "jobs": "/api/model-fitting/jobs",
    "job": "/api/model-fitting/jobs/{job_id}",
    "job_blocks": "/api/model-fitting/jobs/{job_id}/blocks",
    "solution": "/api/model-fitting/solutions/{solution_id}"
  },
  "database": {
    "job_table": "model_fitting_jobs",
    "target_block_table": "model_fitting_target_blocks",
    "solution_table": "model_fitting_solutions",
    "placement_table": "model_fitting_solution_placements",
    "edit_table": "model_fitting_solution_edits",
    "string_lengths": {
      "id": 64,
      "name": 255,
      "status": 64,
      "schema": 64,
      "block_type": 64,
      "candidate_type": 32,
      "candidate_id": 128,
      "source": 64,
      "color_code": 32,
      "edit_type": 64
    },
    "indexes": {
      "job_model": "idx_model_fitting_job_model",
      "job_status": "idx_model_fitting_job_status",
      "job_created": "idx_model_fitting_job_created",
      "block_job": "idx_model_fitting_block_job",
      "solution_job": "idx_model_fitting_solution_job",
      "solution_status": "idx_model_fitting_solution_status",
