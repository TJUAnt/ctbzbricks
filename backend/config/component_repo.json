{
  "schema": "component-repo-v1",
  "audit": {
    "system_user": "system"
  },
  "storage": {
    "default_provider": "supabase",
    "local_provider": "local",
    "supabase_provider": "supabase",
    "bucket": "component-artifacts",
    "object_prefix": "component-repo",
    "local_root_path": "data/component_repo_artifacts",
    "supabase_url_env": "SUPABASE_URL",
    "supabase_publishable_key_env": "SUPABASE_PUBLISHABLE_KEY",
    "supabase_legacy_key_envs": ["SUPABASE_STORAGE_KEY", "SUPABASE_KEY"],
    "content_type_binary": "application/octet-stream",
    "content_type_ldraw": "text/plain; charset=utf-8",
    "content_type_glb": "model/gltf-binary"
  },
  "routes": {
    "component_imports": "/api/component-imports",
    "component_import_upload_session": "/api/component-imports/upload-session",
    "component_import_upload_complete": "/api/component-imports/{upload_session_id}/upload-complete",
    "component_import": "/api/component-imports/{import_id}",
    "component_import_parse": "/api/component-imports/parse",
    "component_import_candidate": "/api/component-imports/{import_id}/candidate",
    "candidate_detail": "/api/component-candidates/{candidate_id}",
    "candidate_preview": "/api/component-candidates/{candidate_id}/preview",
    "candidate_relations": "/api/component-candidates/{candidate_id}/relations",
    "candidate_relations_detect": "/api/component-candidates/{candidate_id}/relations/detect",
    "candidate_relation_confirm": "/api/component-candidates/{candidate_id}/relations/{relation_id}/confirm",
    "candidate_relation_reject": "/api/component-candidates/{candidate_id}/relations/{relation_id}/reject",
    "candidate_connectors": "/api/component-candidates/{candidate_id}/connectors",
    "candidate_connector_summary": "/api/component-candidates/{candidate_id}/connector-summary",
    "candidate_free_connectors": "/api/component-candidates/{candidate_id}/connectors/free",
    "candidate_interfaces": "/api/component-candidates/{candidate_id}/interfaces",
    "candidate_validate": "/api/component-candidates/{candidate_id}/validate",
    "components": "/api/components",
    "component_groups": "/api/component-groups",
    "component_group": "/api/component-groups/{group_id}",
    "component_group_move": "/api/component-groups/{group_id}/move",
    "component_group_components": "/api/component-groups/{group_id}/components",
    "component_group_component_search": "/api/component-groups/{group_id}/components/search",
    "component_group_component": "/api/component-groups/{group_id}/components/{component_id}",
    "component_groups_for_component": "/api/components/{component_id}/groups",
    "component_subscription": "/api/components/{component_id}/subscription",
    "component_preview_first": "/api/component-previews/first",
    "component_preview_model": "/api/component-preview-models/{artifact_id}",
    "component_detail": "/api/components/{component_id}",
    "component_translation": "/api/components/{component_id}/translations/{locale}",
    "part_translation": "/api/parts/{part_number}/translations/{locale}",
    "i18n_metrics": "/api/i18n/metrics",
    "i18n_events": "/api/i18n/events",
    "component_versions": "/api/components/{component_id}/versions",
    "component_version": "/api/component-versions/{version_id}",
    "component_version_delete": "/api/component-versions/{version_id}",
    "component_version_preview": "/api/component-versions/{version_id}/preview",
    "component_version_parts": "/api/component-versions/{version_id}/parts",
    "component_version_publish": "/api/component-versions/{version_id}/publish",
    "component_version_deprecate": "/api/component-versions/{version_id}/deprecate",
    "component_version_archive": "/api/component-versions/{version_id}/archive",
    "component_version_source": "/api/component-versions/{version_id}/source",
    "component_artifact_source": "/api/component-artifacts/{artifact_id}/source"
  },
  "artifacts": {
    "studio_io": "studio_io",
    "ldraw_ldr": "ldraw_ldr",
    "ldraw_mpd": "ldraw_mpd",
    "component_preview_glb": "component_preview_glb",
    "allowed_types": ["studio_io", "ldraw_ldr", "ldraw_mpd"],
    "derived_types": ["component_preview_glb"]
  },
  "ldraw": {
    "parser_version": "component-repo-ldraw-parser-v1",
    "line_separator": "\n",
    "line_number_start": 1,
    "meta_line_type": "0",
    "part_line_type": "1",
    "studio_v2_line_type": "11",
    "file_meta_prefix": "0 FILE ",
    "nofile_meta": "0 NOFILE",
    "name_meta_prefix": "0 Name:",
    "num_of_bricks_prefix": "0 NumOfBricks",
    "type1_token_count": 15,
    "transform_value_count": 12,
    "model_id_prefix": "model",
    "part_instance_id_prefix": "part",
    "submodel_instance_id_prefix": "submodel",
    "default_model_name": "root",
    "issues": {
      "unsupported_line_type": "unsupported_line_type",
      "invalid_type1_line": "invalid_type1_line",
      "duplicate_model_name": "duplicate_model_name",
      "unclosed_model": "unclosed_model"
    }
  },
  "preview": {
    "generator_version": "component-preview-glb-v1",
    "node_binary": "node",
    "meshopt_script": "backend/scripts/meshopt_glb.mjs",
    "meshopt_encoder_module": "frontend/node_modules/meshoptimizer/meshopt_encoder.js",
    "meshopt_timeout_seconds": 30,
    "signed_url_ttl_seconds": 900,
    "ldraw_root_env": "LDRAW_ROOT",
    "ldraw_root_candidates": [
      "/Applications/Studio 2.0/ldraw",
      "D:\\Program Files\\LDraw"
    ],
    "coordinate_precision": 6,
    "mesh": {
      "file_pattern": "*.dat",
      "text_encodings": ["utf-8", "latin-1"],
      "maximum_recursion_depth": 64,
      "line_type": {
        "comment": "0",
        "reference": "1",
        "triangle": "3",
        "quadrilateral": "4"
      },
      "ignored_missing_references": ["6221655zc01.dat"],
      "surface_excluded_path_patterns": [],
      "top_connection_path_patterns": [],
      "syntax": {
        "reference_token_count": 15,
        "triangle_vertex_count": 3,
        "quadrilateral_vertex_count": 4,
        "face_header_token_count": 2,
        "coordinate_count": 3
      },
      "errors": {
        "text_decode": "component_repo.preview_unavailable",
        "maximum_recursion": "component_repo.preview_unavailable",
        "recursive_include": "component_repo.preview_unavailable",
        "missing_file": "component_repo.preview_unavailable",
        "invalid_line": "component_repo.preview_unavailable",
        "missing_reference": "component_repo.preview_unavailable"
      }
    }
  },
  "imports": {
    "background_worker_count": 2,
    "upload_session_status": {
      "pending": "pending",
      "completed": "completed",
      "failed": "failed"
    },
    "status": {
      "uploaded": "uploaded",
      "parsing": "parsing",
      "parsed": "parsed",
      "failed": "failed"
    }
  },
  "candidates": {
    "status": {
      "pending_review": "pending_review",
      "in_review": "in_review",
      "published": "published",
      "rejected": "rejected"
    }
  },
  "components": {
    "status": {
      "draft": "draft",
      "active": "active",
      "archived": "archived"
    }
  },
  "part_library": {
    "default_version_id": "partlib-v1",
    "source_table": "connector_instances",
    "status": {
      "active": "active",
      "deprecated": "deprecated"
    }
  },
  "relations": {
    "candidate_status": {
      "pending": "pending",
      "confirmed": "confirmed",
      "rejected": "rejected",
      "ambiguous": "ambiguous"
    },
    "detection_method": {
      "automatic": "automatic",
      "manual": "manual"
    },
    "joint_type": {
      "fixed": "fixed",
      "revolute": "revolute",
      "unknown": "unknown"
    },
    "connector_capacity": 1,
    "compatibility": [
      {
        "connector_type_a": "technic_pin",
        "connector_type_b": "technic_pin_hole",
        "gender_a": "M",
        "gender_b": "F",
        "connection_type": "pin_hole",
        "joint_type": "revolute",
        "candidate_lateral_ldu": 0.8,
        "candidate_axis_angle_deg": 4.0,
        "verified_lateral_ldu": 0.4,
        "verified_axis_angle_deg": 2.0
      },
      {
        "connector_type_a": "axle",
        "connector_type_b": "axle_hole",
        "gender_a": "M",
        "gender_b": "F",
        "connection_type": "axle_hole",
        "joint_type": "fixed",
        "candidate_lateral_ldu": 0.6,
        "candidate_axis_angle_deg": 3.0,
        "verified_lateral_ldu": 0.3,
        "verified_axis_angle_deg": 1.5
      },
      {
        "connector_type_a": "stud",
        "connector_type_b": "anti_stud",
        "gender_a": "M",
        "gender_b": "F",
        "connection_type": "stud_tube",
        "joint_type": "fixed",
        "candidate_lateral_ldu": 1.0,
        "candidate_axis_angle_deg": 5.0,
        "verified_lateral_ldu": 0.5,
        "verified_axis_angle_deg": 2.0
      }
    ]
  },
  "versions": {
    "status": {
      "draft": "draft",
      "validating": "validating",
      "ready_to_publish": "ready_to_publish",
      "blocked": "blocked",
      "published": "published",
      "deprecated": "deprecated",
      "archived": "archived"
    }
  },
  "interfaces": {
    "exposure": {
      "external": "external",
      "conditional": "conditional",
      "reserved": "reserved"
    },
    "status": {
      "pending": "pending",
      "confirmed": "confirmed",
      "rejected": "rejected"
    },
    "default_behavior": {
      "fixed": "fixed",
      "revolute": "revolute",
      "free": "free"
    }
  },
  "interface_recognition": {
    "version": "component-interface-recognizer-v1",
    "supported_connector_types": [],
    "minimum_outward_score": 0.0,
    "clearance_start_ldu": 2.0,
    "clearance_length_ldu": 16.0,
    "minimum_clearance_radius_ldu": 2.0,
    "connector_length_start_ratio": 0.5
  },
  "validation": {
    "level": {
      "draft": "draft",
      "publish": "publish"
    },
    "validator_version": "component-repo-validator-v1",
    "check_status": {
      "pass": "pass",
      "fail": "fail",
      "warn": "warn"
    }
  },
  "database": {
    "artifact_table": "component_artifacts",
    "upload_session_table": "component_upload_sessions",
    "import_table": "component_imports",
    "scene_snapshot_table": "component_scene_snapshots",
    "candidate_table": "component_candidates",
    "part_library_version_table": "part_library_versions",
    "part_connector_definition_table": "part_connector_definitions",
    "relation_candidate_table": "component_relation_candidates",
    "assembly_relation_table": "component_assembly_relations",
    "component_table": "components",
    "component_version_table": "component_versions",
    "component_interface_table": "component_interfaces",
    "validation_report_table": "component_validation_reports",
    "string_lengths": {
      "id": 36,
      "artifact_type": 32,
      "provider": 32,
      "bucket": 128,
      "sha256": 64,
      "mime_type": 128,
      "status": 32,
      "schema": 64,
      "parser_version": 64,
      "connection_type": 64,
      "connector_type": 64,
      "connector_gender": 16,
      "joint_type": 64,
      "method": 64,
      "user": 128
    },
    "indexes": {
      "artifact_type": "idx_component_artifacts_type",
      "artifact_sha": "idx_component_artifacts_sha256",
      "artifact_uploaded": "idx_component_artifacts_uploaded_at",
      "upload_session_owner": "idx_component_upload_sessions_owner",
      "upload_session_status": "idx_component_upload_sessions_status",
      "upload_session_created": "idx_component_upload_sessions_created_at",
      "import_status": "idx_component_imports_status",
      "import_created": "idx_component_imports_created_at",
      "snapshot_import": "idx_component_scene_snapshots_import",
      "snapshot_created": "idx_component_scene_snapshots_created_at",
      "candidate_import": "idx_component_candidates_import",
      "candidate_status": "idx_component_candidates_status",
      "candidate_created": "idx_component_candidates_created_at",
      "part_library_status": "idx_part_library_versions_status",
      "part_connector_definition_version": "idx_part_connector_definitions_version",
      "part_connector_definition_part": "idx_part_connector_definitions_part",
      "part_connector_definition_type": "idx_part_connector_definitions_type",
      "relation_candidate_component": "idx_component_relation_candidates_candidate",
      "relation_candidate_status": "idx_component_relation_candidates_status",
      "assembly_relation_candidate": "idx_component_assembly_relations_candidate",
      "component_status": "idx_components_status",
      "component_category": "idx_components_category",
      "component_version_component": "idx_component_versions_component",
      "component_version_status": "idx_component_versions_status",
      "component_version_preview_artifact": "idx_component_versions_preview_artifact",
      "component_version_preview_status": "idx_component_versions_preview_status",
      "component_interface_candidate": "idx_component_interfaces_candidate",
      "component_interface_status": "idx_component_interfaces_status",
      "validation_report_candidate": "idx_component_validation_reports_candidate",
      "validation_report_version": "idx_component_validation_reports_version"
    }
  },
  "errors": {
    "invalid_artifact_type": "component_repo.invalid_artifact_type",
    "missing_supabase_config": "component_repo.missing_supabase_config",
    "immutable_artifact_exists": "component_repo.immutable_artifact_exists",
    "artifact_not_found": "component_repo.artifact_not_found",
    "hash_mismatch": "component_repo.hash_mismatch"
  }
}
