{
  "description": "Direct GLB mesh upload and material color extraction.",
  "routes": {
    "mesh_models": "/api/mesh-models",
    "mesh_model_file": "/api/mesh-models/{model_id}/file"
  },
  "storage": {
    "model_store_path": "data/imported_mesh_models",
    "model_file_extension": ".glb",
    "model_id_hex_length": 32
  },
  "upload": {
    "allowed_extensions": [".glb"],
    "allowed_content_types": ["model/gltf-binary", "application/octet-stream"],
    "max_file_size_bytes": 52428800
  },
  "model_asset": {
    "model_type": "mesh",
    "source_type": "direct_upload",
    "complete_status": "complete"
  },
  "response": {
    "media_type": "model/gltf-binary"
  },
  "color_summary": {
    "source": "material",
    "not_processed": "not_processed",
    "default_material_name": "Default material",
    "default_color_factor": [1, 1, 1, 1],
    "fallback_material_index": -1,
    "hex_multiplier": 255,
    "hex_template": "#{red:02X}{green:02X}{blue:02X}",
    "coverage_decimals": 4,
    "rgba_decimals": 4
  },
  "glb": {
    "magic": "glTF",
    "version": 2,
    "header_struct": "<4sII",
    "chunk_header_struct": "<II",
    "header_length": 12,
    "chunk_header_length": 8,
    "json_chunk_type": 1313821514,
    "binary_encoding": "ascii",
    "json_encoding": "utf-8",
    "triangles_mode": 4,
    "indices_per_triangle": 3,
    "position_attribute": "POSITION"
  },
  "json_keys": {
    "materials": "materials",
    "meshes": "meshes",
    "primitives": "primitives",
    "pbr": "pbrMetallicRoughness",
    "base_color_factor": "baseColorFactor",
    "base_color_texture": "baseColorTexture",
    "name": "name",
    "material": "material",
    "mode": "mode",
    "indices": "indices",
    "attributes": "attributes",
    "accessors": "accessors",
    "count": "count"
  },
  "metadata_keys": {
    "file_size_bytes": "fileSizeBytes",
    "content_type": "contentType",
    "original_extension": "originalExtension",
    "color_summary": "colorSummary",
    "texture_sampling_status": "textureSamplingStatus",
    "has_base_color_texture": "hasBaseColorTexture"
  },
  "errors": {
    "missing_filename": "mesh_model.missing_filename",
    "unsupported_extension": "mesh_model.unsupported_extension",
    "unsupported_content_type": "mesh_model.unsupported_content_type",
    "file_too_large": "mesh_model.file_too_large",
    "invalid_glb": "mesh_model.invalid_glb",
    "model_not_found": "mesh_model.model_not_found"
  },
  "http_status": {
    "bad_request": 400,
    "not_found": 404
  }
}
