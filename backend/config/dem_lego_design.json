      "180": [0, 0, -1, 0, 1, 0, 1, 0, 0],
      "270": [-1, 0, 0, 0, 1, 0, 0, 0, -1]
    },
    "surface_rotation_matrices": {
      "0": [1, 0, 0, 0, 1, 0, 0, 0, 1],
      "90": [0, 0, 1, 0, 1, 0, -1, 0, 0],
      "180": [-1, 0, 0, 0, 1, 0, 0, 0, -1],
      "270": [0, 0, -1, 0, 1, 0, 1, 0, 0]
    },
    "placement_ref_kinds": {
      "structure": "structure",
      "surface": "surface",
      "white_base": "whiteBase",
      "black_support": "blackSupport"
    },
    "steps": {
      "maximum_placements_per_step": 30,
      "maximum_part_types_per_step": 10
    }
  }
}
