    "errors": {
      "rotation_missing": "Vertical continuity rotation is not configured",
      "sample_resolution": "Vertical continuity must sample exactly one column per LDU",
      "profile_sample_resolution": "Vertical continuity profile resolution does not match one LDU",
      "profile_missing": "Vertical continuity profile is missing for {part_id}"
    }
  },
  "final_design": {
    "description": "Return only a surface plan whose solid BaseH can be tiled and globally validated.",
    "strategy": "surface-structure-validated",
    "strategies": {
      "surface_plan": "surface-plan",
      "colored_replacement": "colored-replacement"
    },
    "surface_candidate_layers": [
      {"allow_nearest_color": false, "allow_approximate_geometry": false},
      {"allow_nearest_color": true, "allow_approximate_geometry": false},
      {"allow_nearest_color": false, "allow_approximate_geometry": true},
      {"allow_nearest_color": true, "allow_approximate_geometry": true}
    ],
    "roles": {
      "surface": "surface"
    },
    "bom_role_order": ["black_support", "white_base", "surface", "brick", "plate"],
    "color": {
      "rgb_prefix": "#",
      "ldraw_code_template": "{color_id}"
    },
    "inventory_colors": {
      "xref_relation": "exact",
      "part_number_fallbacks": {
        "3046.dat": ["3046a", "3046b"]
      },
      "hex_radix": 16,
      "distance_exponent": 2,
      "maximum_squared_distance": 900,
      "rgb_channels": {
        "red_start": 0,
        "red_end": 2,
        "green_start": 2,
        "green_end": 4,
        "blue_start": 4,
        "blue_end": 6
      },
      "errors": {
        "target_color_missing": "Final DEM design target color metadata is missing"
      }
    },
    "steps": {
      "index_start": 1,
      "id_template": "dem-step-{index}",
      "structure_name_template": "Base layer {base_plate}",
      "structure_stage": "structure",
      "surface_ref_kind": "surface",
      "surface_phases": [
        {
          "connection_class": "top_connected",
          "name_template": "Connected slope replacement {base_plate}",
          "stage": "surface-connected"
        },
        {
          "connection_class": "top_finished",
          "name_template": "Finished slope decoration {base_plate}",
          "stage": "surface-finished"
        },
        {
          "connection_class": "colored_replacement_supplement",
          "name_template": "Colored replacement supplement {base_plate}",
          "stage": "surface-supplement"
        },
        {
          "connection_class": "surface_fill",
          "name_template": "Surface fill {base_plate}",
          "stage": "surface-fill"
        }
      ],
      "maximum_placements_per_step": 100
    },
    "errors": {
      "strategy_invalid": "DEM final design strategy is not configured",
      "part_metadata_missing": "Final DEM design is missing LDraw part metadata",
      "color_metadata_missing": "Final DEM design is missing color metadata",
      "structure_not_coverable": "No globally selected surface plan has a buildable BaseH structure",
      "validation_failed": "Final DEM design failed global validation"
    }
  },
  "errors": {
    "base_h_empty": "BaseH must contain at least one row and one column",
    "base_h_not_rectangular": "BaseH rows must have equal lengths",
    "base_h_negative": "BaseH heights must be non-negative integers",
    "part_metadata_missing": "DEM BaseH requires configured brick and plate candidates",
    "base_h_uncovered": "DEM BaseH cannot be covered by the configured LEGO parts",
    "surface_profile_part_id": "LDraw part id must include a valid .dat file name"
  },
  "http_status": {
    "bad_request": 400
  },
  "dem_ldraw": {
    "content_type": "text/plain; charset=utf-8",
    "filename_template": "dem-lego-design.ldr",
    "content_disposition_header": "Content-Disposition",
    "content_disposition_template": "attachment; filename=\"{filename}\"",
    "line_separator": "\n",
    "metadata_line_type": 0,
    "part_line_type": 1,
    "file_command": "FILE",
    "name_command": "Name:",
    "author_command": "Author:",
    "author": "ctbzbricks",
    "model_file_name": "dem-lego-design.ldr",
    "comment_prefix": "//",
    "step_command": "STEP",
    "ldu_per_stud": 20,
    "ldu_per_plate": 8,
    "y_ground_ldu": 0,
    "y_direction": -1,
    "coordinate_precision": 6,
    "support_origin_to_base_ldu": 0,
    "support_origin_center_x_ldu": 0,
    "support_origin_center_z_ldu": 0,
    "part_origin_offset_divisor": 2,
    "x_origin_grid_width_multiplier": 0,
    "x_direction": 1,
    "z_origin_grid_height_multiplier": 1,
    "z_direction": -1,
    "structure_rotation_matrices": {
      "0": [0, 0, 1, 0, 1, 0, -1, 0, 0],
