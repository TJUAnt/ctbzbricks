# Preferred Supabase/PostgreSQL connection. Copy the value from Supabase > Connect.
# Persistent IPv6 backend: use the direct connection on port 5432.
# Persistent IPv4-only backend: use the session pooler on port 5432.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Component Repo artifact storage.
# Use local for offline development, or supabase when the Storage bucket/policies are configured.
COMPONENT_REPO_STORAGE_PROVIDER=local
REQUIRE_AUTH_FOR_COMPONENT_REPO=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_STORAGE_KEY=replace-with-storage-scoped-key

# LDraw/Studio part library used to build exact Component preview meshes.
# macOS Studio default: /Applications/Studio 2.0/ldraw
# Windows LDraw default: D:\Program Files\LDraw
LDRAW_ROOT=/path/to/ldraw

# Temporary legacy MySQL fallback. These are only read when DATABASE_URL is absent.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=lego_db
# MYSQL_CHARSET=utf8mb4
